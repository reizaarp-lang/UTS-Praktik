[
    {
        "id": "tab_uts_iot",
        "type": "tab",
        "label": "UTS IoT - Monitoring Suhu & Kelembapan",
        "disabled": false,
        "info": "Flow UTS Praktik Sistem Monitoring Suhu & Kelembapan"
    },
    {
        "id": "emqx_public_broker",
        "type": "mqtt-broker",
        "name": "EMQX Public Broker",
        "broker": "broker.emqx.io",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "mqtt_in_node",
        "type": "mqtt in",
        "z": "tab_uts_iot",
        "name": "MQTT Subscribe (Ketentuan 6)",
        "topic": "uts-iot/nama_mahasiswa/dht22",
        "qos": "2",
        "datatype": "auto-detect",
        "broker": "emqx_public_broker",
        "nl": false,
        "rap": true,
        "inputs": 0,
        "x": 170,
        "y": 220,
        "wires": [
            [
                "json_parse_node"
            ]
        ]
    },
    {
        "id": "json_parse_node",
        "type": "json",
        "z": "tab_uts_iot",
        "name": "Parse JSON",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 410,
        "y": 220,
        "wires": [
            [
                "func_process_data"
            ]
        ]
    },
    {
        "id": "func_process_data",
        "type": "function",
        "z": "tab_uts_iot",
        "name": "Processing & Threshold Logic",
        "func": "// 1. Mengambil Nilai Suhu & Kelembapan\nlet temp = parseFloat(msg.payload.temperature);\nlet humidity = parseFloat(msg.payload.humidity);\n\n// 2. Standar Threshold Kenyamanan Termal\n// Suhu Normal: 20°C - 28°C | Kelembapan Normal: 40% - 60%\nlet tempNormal = (temp >= 20 && temp <= 28);\nlet humNormal = (humidity >= 40 && humidity <= 60);\n\n// 3. Evaluasi Status\nlet overallStatus = (tempNormal && humNormal) ? \"NORMAL\" : \"ABNORMAL\";\nlet notifMessage = \"\";\n\nif (overallStatus === \"ABNORMAL\") {\n    let alertList = [];\n    if (!tempNormal) alertList.push(`Suhu di luar batas (${temp}°C)`);\n    if (!humNormal) alertList.push(`Kelembapan di luar batas (${humidity}%)`);\n    notifMessage = \"⚠️ WARNING: \" + alertList.join(\" & \");\n} else {\n    notifMessage = \"✅ Kondisi Lingkungan Ideal / Normal.\";\n}\n\n// 4. Output ke Dashboard Node-RED\nreturn [\n    { payload: temp },         // Output 1: Suhu\n    { payload: humidity },     // Output 2: Kelembapan\n    { payload: overallStatus },// Output 3: Status (NORMAL/ABNORMAL)\n    { payload: notifMessage }  // Output 4: Notifikasi Pop-up\n];",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 220,
        "wires": [
            [
                "ui_gauge_temp",
                "ui_chart_temp"
            ],
            [
                "ui_gauge_hum",
                "ui_chart_hum"
            ],
            [
                "ui_text_status"
            ],
            [
                "ui_toast_notif"
            ]
        ]
    },
    {
        "id": "inject_normal",
        "type": "inject",
        "z": "tab_uts_iot",
        "name": "Test Data Normal (24°C, 50%)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"temperature\": 24.5, \"humidity\": 50.0}",
        "payloadType": "json",
        "x": 190,
        "y": 120,
        "wires": [
            [
                "json_parse_node"
            ]
        ]
    },
    {
        "id": "inject_abnormal",
        "type": "inject",
        "z": "tab_uts_iot",
        "name": "Test Data Abnormal (33°C, 75%)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"temperature\": 33.2, \"humidity\": 75.0}",
        "payloadType": "json",
        "x": 200,
        "y": 160,
        "wires": [
            [
                "json_parse_node"
            ]
        ]
    },
    {
